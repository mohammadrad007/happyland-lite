{
  "name": "happyland-lite",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd backend && npm install",
    "tw:build": "tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind.css --minify",
    "tw:watch": "tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind.css --watch",
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "cd backend && node server.js",
    "dev:front": "lite-server --baseDir=frontend --port=5500",
    "start": "npm run tw:build && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "lite-server": "^2.6.1",
    "tailwindcss": "^3.4.17"
  }
}
